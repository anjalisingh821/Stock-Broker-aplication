// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  password      String
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  accounts      Account[]
  sessions      Session[]
  profile       Profile?
  orders        Order[]
  positions     Position[]
  watchlists    Watchlist[]
  alerts        Alert[]
  transactions  Transaction[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Profile {
  id            String   @id @default(cuid())
  userId        String   @unique
  pan           String?
  aadhar        String?
  bankAccount   String?
  ifsc          String?
  kycStatus     String   @default("PENDING") // PENDING, VERIFIED, REJECTED
  cashBalance   Float    @default(100000)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Order {
  id              String   @id @default(cuid())
  userId          String
  symbol          String
  side            String   // BUY, SELL
  type            String   // MARKET, LIMIT, STOP_LOSS, STOP_LOSS_LIMIT
  quantity        Int
  price           Float?
  stopPrice       Float?
  status          String   @default("PENDING") // PENDING, PLACED, EXECUTED, PARTIALLY_EXECUTED, CANCELLED, REJECTED
  filledQuantity  Int      @default(0)
  averagePrice    Float?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Position {
  id            String   @id @default(cuid())
  userId        String
  symbol        String
  quantity      Int
  averagePrice  Float
  currentPrice  Float
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([userId, symbol])
}

model Watchlist {
  id        String   @id @default(cuid())
  userId    String
  symbol    String
  createdAt DateTime @default(now())
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([userId, symbol])
}

model Alert {
  id          String   @id @default(cuid())
  userId      String
  symbol      String
  type        String   // PRICE, PERCENTAGE
  value       Float
  condition   String   // ABOVE, BELOW
  triggered   Boolean  @default(false)
  createdAt   DateTime @default(now())
  
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Transaction {
  id          String   @id @default(cuid())
  userId      String
  type        String   // DEPOSIT, WITHDRAWAL, ORDER_EXECUTION
  amount      Float
  description String?
  createdAt   DateTime @default(now())
  
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

